# ClusterMCP Server config
# Copy to .env and fill real values (never commit secrets)
PVE_HOST=https://pve-01:8006
PVE_TOKEN_ID=hermes@pam!hermes-mcp
PVE_TOKEN_SECRET=your-long-token-secret-here
VERIFY_SSL=false  # true only if you have valid certs

# Optional API key (protects all routes including /wardens/*)
# MCP_API_KEY=

# Wardens data (inventory, SSH keys, reports)
# WARDENS_DATA_DIR=/var/lib/clustermcp/wardens
# CLUSTERMCP_DATA_DIR=/var/lib/clustermcp

# Path to built bridge binary used by setup/fleet-sync (default: repo wardens/build/collector)
# WARDENS_COLLECTOR_BIN=/opt/clustermcp/wardens/build/collector

# --- Wardens security / automation ---
# Lock MCP SSH keys to source IPs (OpenSSH authorized_keys from=). Comma-separated.
# Use your MCP LXC address or management CIDR. Empty = no from= restriction.
# WARDENS_SSH_FROM=192.168.0.233

# MCP-side collect-all interval in seconds. 0 or unset = off (manual/fleet only).
# Example: 300 = every 5 minutes.
# WARDENS_COLLECT_INTERVAL_SEC=300

# After successful admin OTA (POST /admin/update): build+push+collect all nodes before restart.
# Default true. Set false to only update MCP code.
# FLEET_SYNC_ON_OTA=true

# One-shot setup password via env (popped at runtime; never written to disk). Prefer prompt/stdin.
# CLUSTER_SETUP_PASSWORD=
