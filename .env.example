# ClusterMCP Server config
# Copy to .env and fill real values (never commit secrets)
PVE_HOST=https://pve-01:8006
PVE_TOKEN_ID=hermes@pam!hermes-mcp
PVE_TOKEN_SECRET=your-long-token-secret-here
VERIFY_SSL=false  # true only if you have valid certs
# Optional API key (protects all routes including /wardens/*)
# MCP_API_KEY=
# Wardens data (inventory, SSH keys, reports) — default /var/lib/clustermcp/wardens
# WARDENS_DATA_DIR=/var/lib/clustermcp/wardens
# CLUSTERMCP_DATA_DIR=/var/lib/clustermcp
# Optional override for setup packaging path to the built bridge binary
# WARDENS_COLLECTOR_BIN=/opt/clustermcp/wardens/build/collector
# One-shot setup password via env (popped at runtime; never written to disk) — prefer prompt/stdin
# CLUSTER_SETUP_PASSWORD=# Restrict MCP SSH key by source (authorized_keys from=). Comma-separated.
# WARDENS_SSH_FROM=192.168.0.0/24
# MCP-side interval collect-all seconds (0=off)
# WARDENS_COLLECT_INTERVAL_SEC=300
# After admin OTA, run fleet-sync before restart (default true)
# FLEET_SYNC_ON_OTA=true
